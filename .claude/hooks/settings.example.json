{
  "_comment": "Drop these blocks into ~/.claude/settings.json (or merge with project settings). Paths must be absolute and point at this directory on your machine. If you install the hmcts-sdlc-orchestrator plugin instead, all of this is wired for you by hooks/hooks.json — do not do both.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/cpp/cpp-claude/.claude/hooks/harness-telemetry.sh" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/cpp/cpp-claude/.claude/hooks/harness-telemetry.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/cpp/cpp-claude/.claude/hooks/harness-telemetry.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Task|Agent|Write|Edit",
        "hooks": [
          { "type": "command", "command": "$HOME/cpp/cpp-claude/.claude/hooks/harness-telemetry.sh" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "$HOME/cpp/cpp-claude/.claude/hooks/block-secrets.sh" },
          { "type": "command", "command": "$HOME/cpp/cpp-claude/.claude/hooks/block-pii.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$HOME/cpp/cpp-claude/.claude/hooks/guard-bash.sh" }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "$HOME/cpp/cpp-claude/.claude/hooks/block-secrets.sh" },
          { "type": "command", "command": "$HOME/cpp/cpp-claude/.claude/hooks/block-pii.sh" },
          { "type": "command", "command": "$HOME/cpp/cpp-claude/.claude/hooks/guard-paths.sh" }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "$HOME/cpp/cpp-claude/.claude/hooks/guard-paths.sh" }
        ]
      }
    ]
  }
}
